# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Twilio Configuration (Optional - for webhook validation in production)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Server Configuration
YOUR_DOMAIN=your-domain.com
# For local development with ngrok: abc123.ngrok.io
# For production: voice.yourcompany.com

PORT=5000

# Logging Configuration
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FILE=logs/app.log

# Audio Configuration (Advanced)
AUDIO_SAMPLE_RATE=16000
VAD_THRESHOLD=0.5
SILENCE_DURATION_MS=700

# Session Configuration
SESSION_TIMEOUT_SECONDS=300
MAX_CONCURRENT_CALLS=50

# Development
DEBUG=False
